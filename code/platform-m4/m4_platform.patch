diff --git a/evaluation/fr09_fit/choose_threshold_m4.py b/evaluation/fr09_fit/choose_threshold_m4.py
new file mode 100644
index 0000000..bf7ed62
--- /dev/null
+++ b/evaluation/fr09_fit/choose_threshold_m4.py
@@ -0,0 +1,51 @@
+"""FR-09 integration check for M4 (validation split only; the test split is not read).
+
+    python evaluation/fr09_fit/choose_threshold_m4.py --dl ../HireMind-DL
+
+Runs every validation pair through backend/app/fit_model.py (the platform's own code, which adds the Knowledge v1 line),
+checks that the result equals the frozen model's recorded validation numbers, then applies the platform's review rule:
+the highest threshold (step 0.025) that still flags at least half of the Good Fit pairs. Writes the threshold into
+backend/models/fit_model.json and the evidence into evaluation/fr09_fit/m4_threshold_report.json.
+"""
+import argparse, json, sys
+from pathlib import Path
+import numpy as np
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "backend"))
+
+ap = argparse.ArgumentParser(); ap.add_argument("--dl", required=True); a = ap.parse_args()
+sys.path.insert(0, str(Path(a.dl).resolve() / "src"))
+from hiremind_dl import load_config
+from hiremind_dl.data import download_raw, load_manifest, read_raw, split_frame
+card_path = ROOT / "backend/models/fit_model.json"
+card = json.loads(card_path.read_text())
+if not isinstance(card["review_threshold"], (int, float)):
+    card["review_threshold"] = 0.5; card_path.write_text(json.dumps(card, indent=2) + "\n")  # placeholder so the module loads
+from app import config, fit_model
+config.FIT_ENABLED = True
+st = fit_model.status(); assert st["available"], st["reason"]
+cfg = load_config(Path(a.dl) / "configs" / "experiment.json")
+raw = {"train": read_raw(download_raw(cfg, "train"))}  # the test file is never downloaded
+d = split_frame(raw, load_manifest(cfg), "validation", cfg["dataset"]["rows"]["validation"])
+pairs = [(cv if isinstance(cv, str) else "", job if isinstance(job, str) else "") for cv, job in zip(d.resume_text, d.job_description_text)]
+probs = np.array([p for i in range(0, len(pairs), 32) for p in fit_model.predict_batch(pairs[i:i + 32])])
+y = d.label_id.to_numpy(); pred = probs.argmax(1)
+cm = np.zeros((3, 3), int)
+for t, p in zip(y, pred): cm[t, p] += 1
+acc = 100 * (pred == y).mean(); gfr = 100 * cm[2, 2] / cm[2].sum()
+rec = card["recorded_results"]
+print(f"platform code on validation: accuracy {acc:.2f} (frozen {rec['validation_accuracy']}), Good Fit recall {gfr:.2f} (frozen {rec['validation_good_fit_recall']})")
+print("confusion", cm.tolist(), "frozen", rec["validation_confusion"])
+assert abs(acc - rec["validation_accuracy"]) <= 0.2, "platform predictions differ from the frozen model"
+good = y == 2
+grid = [round(t, 3) for t in np.arange(0.025, 1.0, 0.025)]
+ok = [t for t in grid if (probs[good, 2] >= t).mean() >= 0.5]
+thr = max(ok)
+flag = probs[:, 2] >= thr
+card["review_threshold"] = thr
+card_path.write_text(json.dumps(card, indent=2) + "\n")
+rep = dict(split="validation", rows=int(len(y)), accuracy=round(acc, 2), good_fit_recall=round(gfr, 2), confusion=cm.tolist(),
+           review_threshold=thr, flagged_share=round(100 * flag.mean(), 1), good_fit_caught=round(100 * flag[good].mean(), 1),
+           good_fit_among_flagged=round(100 * good[flag].mean(), 1))
+(ROOT / "evaluation/fr09_fit/m4_threshold_report.json").write_text(json.dumps(rep, indent=2) + "\n")
+print(json.dumps(rep))
